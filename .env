ROS_DOMAIN_ID=31
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

YOLO_LAUNCH_FILE=yolo.launch.py
MODEL_SOURCE_PATH=/home/coresense/yolo_models # Folder on Local Machine with Custom Models
