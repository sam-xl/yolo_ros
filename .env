ROS_DOMAIN_ID=31
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Mount Configuration
MODEL_SOURCE_PATH=/home/coresense/yolo_models # Folder on Local Machine with Custom Models
MODEL_TARGET_PATH=/home/ros/yolo_models # Folder in container holding custom models

# Base Model Configuration
YOLO_LAUNCH_FILE=yolo.launch.py
YOLO_MODEL= yolo11m.pt # $MODEL_TARGET_PATH/coresense_yolo11m_fullyTrained.pt # Either path to custom model or name of downloadable model(e.g. just yolo11m.pt)
YOLO_INPUT_TOPIC=/camera/camera/color/image_raw
YOLO_AUGMENTATION=False # whether or not to use test-time augmentation. 

# Depth-Related Configuration 
YOLO_USE_3D=True
YOLO_DEPTH_TOPIC=/camera/camera/depth/image_rect_raw
YOLO_DEPTH_INFO_TOPIC=/camera/camera/depth/camera_info